{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terminal soundscape manifest",
  "type": "object",
  "required": [
    "version",
    "assets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "source_url",
          "creator",
          "license",
          "license_url",
          "rights_evidence_url",
          "rights_verified_date",
          "attribution",
          "authenticity",
          "authenticity_evidence",
          "event",
          "playback",
          "playback_guidance",
          "processing",
          "quality_notes",
          "review_status",
          "reviewer",
          "review_notes",
          "path",
          "source_sha256",
          "sha256",
          "audio",
          "commercial_use",
          "share_alike"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "creator": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "enum": [
              "CC0-1.0",
              "CC-BY-4.0",
              "CC-BY-SA-4.0",
              "CC-BY-NC-4.0",
              "CC-BY-NC-SA-4.0"
            ]
          },
          "license_url": {
            "type": "string",
            "minLength": 1
          },
          "rights_evidence_url": {
            "type": "string",
            "minLength": 1
          },
          "rights_verified_date": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "authenticity": {
            "type": "string",
            "minLength": 1
          },
          "authenticity_evidence": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "playback": {
            "enum": [
              "one-shot",
              "full-event",
              "loop"
            ]
          },
          "playback_guidance": {
            "type": "string",
            "minLength": 1
          },
          "processing": {
            "type": "string",
            "minLength": 1
          },
          "quality_notes": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "pending",
              "reviewed"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "review_notes": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "audio": {
            "type": "object",
            "required": [
              "sample_rate",
              "channels",
              "bit_depth",
              "duration_seconds",
              "peak",
              "clipped_samples"
            ],
            "properties": {
              "sample_rate": {
                "type": "integer"
              },
              "channels": {
                "type": "integer"
              },
              "bit_depth": {
                "type": "integer"
              },
              "duration_seconds": {
                "type": "number"
              },
              "peak": {
                "type": "integer"
              },
              "clipped_samples": {
                "type": "integer"
              }
            }
          },
          "commercial_use": {
            "type": "boolean"
          },
          "share_alike": {
            "type": "boolean"
          },
          "priority_category": {
            "enum": [
              "crane movement",
              "container contact",
              "carrier or tractor movement",
              "terminal warnings",
              "reefer ambience",
              "harbour ambience"
            ]
          }
        }
      }
    }
  }
}
